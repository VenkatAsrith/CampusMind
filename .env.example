# ==============================================================================
# CampusMind Root — Environment Configuration (.env.example)
# Copy this file to .env and configure values appropriate for your environment.
# Never commit .env with production credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME=CampusMind

# Server & Database
DATABASE_URL=postgresql+psycopg2://campusmind_user:campusmind_secure_db_password_2026@postgres:5432/campusmind_db
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Anthropic Claude Integration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Retrieval & Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
SIMILARITY_THRESHOLD=0.30
TOP_K_CHUNKS=4

# CORS
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Frontend Environment Variable
VITE_API_BASE_URL=/api
