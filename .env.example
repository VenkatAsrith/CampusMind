# ==============================================================================
# CampusMind Backend — Environment Configuration (.env.example)
# Copy this file to .env and configure values appropriate for your environment.
# Never commit .env with production credentials to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME=CampusMind Backend
API_V1_STR=/api

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & JWT Configuration
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL & pgvector Database Connection
# Format: postgresql+psycopg2://username:password@hostname:5432/database_name
# For Docker environment: postgresql+psycopg2://campusmind_user:campusmind_password@postgres:5432/campusmind_db
# For Local/Test SQLite fallback in test suites: sqlite:///./campusmind_test.db
DATABASE_URL=postgresql+psycopg2://campusmind_user:campusmind_password@localhost:5432/campusmind_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Embedding Service Configuration
# Model dimension must strictly match embedding model output.
# all-MiniLM-L6-v2 produces 384 dimensions.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
# Set USE_MOCK_EMBEDDINGS=true for isolated local test runs or CI without downloading heavy weights
USE_MOCK_EMBEDDINGS=false

# Vector Retrieval & Relevance Gatekeeping
TOP_K_CHUNKS=4
# Similarity threshold: cosine similarity between 0.0 and 1.0 (higher = closer match).
# If no retrieved chunk meets this threshold, LLM generation is skipped.
SIMILARITY_THRESHOLD=0.30

# Chunking Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Document Ingestion & Storage
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
ALLOWED_FILE_EXTENSIONS=pdf,docx,txt
UPLOAD_DIR=./data/uploads

# Hosted LLM Integration
# Supports OpenAI-compatible providers (OpenAI, Groq, DeepSeek, Ollama, vLLM, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Set USE_MOCK_LLM=true for offline testing
USE_MOCK_LLM=false

# CORS & Frontend Origins
# Add Person 1's frontend dev server (e.g. http://localhost:3000 or http://localhost:5173)
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
